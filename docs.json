{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Djonanko Pay",
  "description": "Documentation développeur de Djonanko Pay — la passerelle de paiement mobile money pour l'Afrique de l'Ouest et du Centre.",
  "colors": {
    "primary": "#0B4530",
    "light": "#2E9E6C",
    "dark": "#0B4530"
  },
  "logo": {
    "light": "/logo/logo.png",
    "dark": "/logo/logo.png",
    "href": "https://djonanko.ci"
  },
  "favicon": "/favicon.png",
  "background": {
    "decoration": "gradient"
  },
  "fonts": {
    "family": "Inter"
  },
  "appearance": {
    "default": "system"
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard marchand",
        "href": "https://pay.djonanko.tech/login"
      },
      {
        "label": "Support",
        "href": "https://www.djonanko.ci/#contact"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Créer un compte",
      "href": "https://pay.djonanko.tech/#register"
    }
  },
  "navigation": {
